  "behavior": "계산",
  "question": "$\\sqrt{(-5)^2}-\\sqrt[3]{(-2)^3}+\\sqrt[4]{(-3)^4}$의 값을 구하시오.",
  "condition": null,
  "choices": null,
  "answer": "10",
