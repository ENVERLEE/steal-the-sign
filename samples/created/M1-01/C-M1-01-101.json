  "difficulty": "조건 변형",
  "behavior": "계산",
  "question": "$\\sqrt[3]{-8}\\times\\sqrt[3]{-27}+\\sqrt[4]{81}$의 값을 구하시오.",
  "condition": null,
  "choices": null,
  "answer": "9",
