  "solution": {
    "concept_refs": [
      "수학Ⅰ-01-C1"
    ],
    "guide": "부호와 지수 규칙을 먼저 정리하면 계산이 짧아진다.",
    "solutions": [
      {
        "title": "풀이 1 · 규칙 먼저",
        "steps": [
          {
            "label": "정리",
            "body": "음의 지수는 뒤집기: $\\left(\\frac1{27}\\right)^{-\\frac13}=27^{\\frac13}=3$"
          },
          {
            "label": "계산",
            "body": "$3\\times4=12$"
          }
        ]
      },
      {
        "title": "풀이 2 · 차례로 계산 (비교용)",
        "steps": [
          {
            "label": "1단계",
            "body": "$\\frac{1}{27}=3^{-3}$이므로 $\\left(3^{-3}\\right)^{-\\frac{1}{3}}=3^{(-3)\\cdot\\left(-\\frac{1}{3}\\right)}$이다."
          },
          {
            "label": "2단계",
            "body": "지수를 곱하면 $(-3)\\cdot\\left(-\\frac{1}{3}\\right)=1$이므로 $3^1=3$이다."
          },
          {
            "label": "3단계",
            "body": "따라서 $3\\times 2^2=3\\times4=12$이다."
          }
        ]
      }
    ],
    "supplement": "부호를 마지막에 처리하면 홀수 제곱근에서 부호를 놓치기 쉽다. 계산 전에 부호부터 확정한다.",
    "skill_point": "계산 전에 부호와 지수 규칙부터 확정한다."
  },
  "verify": "def skill():\n    return Rational(1,27)**Rational(-1,3)*4\n\ndef standard():\n    return 3*4\n\ndef unique():\n    return [standard()]\n"
