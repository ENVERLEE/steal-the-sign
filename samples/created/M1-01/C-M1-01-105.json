      {
        "title": "풀이 1 · 규칙 먼저",
        "steps": [
          {
            "label": "정리",
            "body": "합차 꼴: $(x+3)^2-(x-3)^2=4\\cdot x\\cdot 3=12x$"
          },
          {
            "label": "계산",
            "body": "$x=2$ → $24$"
          }
        ]
      },
      {
        "title": "풀이 2 · 차례로 계산 (비교용)",
        "steps": [
          {
            "label": "1단계",
            "body": "$x=2$를 대입하면 $(2+3)^2=25$이다."
          },
          {
            "label": "2단계",
            "body": "$(2-3)^2=(-1)^2=1$이다."
          },
          {
            "label": "3단계",
            "body": "따라서 $25-1=24$이다."
          }
        ]
      }
    ],
